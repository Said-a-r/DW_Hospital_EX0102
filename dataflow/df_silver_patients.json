{
	"name": "df_silver_patients",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_patients",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_patients",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "filterValidos"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(patient_id = trim(patient_id),",
				"          full_name = iif(isNull(full_name) || trim(replace(full_name, 'Â', '')) == '', toString(null()), trim(replace(full_name, 'Â', ''))),",
				"          gender = iif(isNull(gender) || trim(gender) == '', toString(null()), trim(gender)),",
				"          date_of_birth = iif(isNull(date_of_birth) || trim(date_of_birth) == '', toString(null()), trim(date_of_birth)),",
				"          phone = iif(isNull(phone) || trim(phone) == '' || upper(trim(phone)) == 'UNKNOWN', toString(null()), trim(phone)),",
				"          email = iif(isNull(email) || trim(email) == '', toString(null()), trim(email)),",
				"          address = iif(isNull(address) || trim(address) == '', toString(null()), trim(address)),",
				"          insurance_provider = iif(isNull(insurance_provider) || trim(insurance_provider) == '', toString(null()), trim(insurance_provider))) ~> derivedColumn1",
				"derivedColumn1 derive(gender = iif(isNull(gender), toString(null()), iif(upper(gender) == 'M' || upper(gender) == 'MALE', 'Male', iif(upper(gender) == 'F' || upper(gender) == 'FEMALE', 'Female', gender))),",
				"          email = iif(isNull(email), toString(null()), lower(replace(replace(replace(email, ' at ', '@'), ',com', '.com'), 'gmial.com', 'gmail.com'))),",
				"          insurance_provider = iif(isNull(insurance_provider), toString(null()), iif(upper(replace(replace(replace(insurance_provider, ' ', ''), '-', ''), '.', '')) == 'CIGNA', 'Cigna', iif(upper(replace(replace(replace(insurance_provider, ' ', ''), '-', ''), '.', '')) == 'CIGNAHEALTH', 'Cigna', iif(upper(replace(replace(replace(insurance_provider, ' ', ''), '-', ''), '.', '')) == 'AETNA', 'Aetna', iif(upper(replace(replace(replace(insurance_provider, ' ', ''), '-', ''), '.', '')) == 'AETNAA', 'Aetna', iif(upper(replace(replace(replace(insurance_provider, ' ', ''), '-', ''), '.', '')) == 'AETNAINC', 'Aetna', iif(upper(replace(replace(replace(insurance_provider, ' ', ''), '-', ''), '.', '')) == 'BLUECROSS', 'BlueCross', iif(upper(replace(replace(replace(insurance_provider, ' ', ''), '-', ''), '.', '')) == 'UHC', 'UnitedHealth', iif(upper(replace(replace(replace(insurance_provider, ' ', ''), '-', ''), '.', '')) == 'UNITEDHEALTH', 'UnitedHealth', iif(upper(replace(replace(replace(insurance_provider, ' ', ''), '-', ''), '.', '')) == 'MEDICAID', 'Medicaid', iif(upper(replace(replace(replace(insurance_provider, ' ', ''), '-', ''), '.', '')) == 'MEDICARE', 'Medicare', iif(upper(replace(replace(replace(insurance_provider, ' ', ''), '-', ''), '.', '')) == 'SELFPAY', 'Self-Pay', insurance_provider))))))))))))) ~> derivedColumn2",
				"derivedColumn2 derive(date_of_birth = iif(isNull(date_of_birth), toString(null()), iif(regexMatch(date_of_birth, `^\\d{4}-\\d{2}-\\d{2}$`), date_of_birth, iif(regexMatch(date_of_birth, `^\\d{2}/\\d{2}/\\d{4}$`), toString(toDate(date_of_birth, 'MM/dd/yyyy'), 'yyyy-MM-dd'), iif(regexMatch(date_of_birth, `^\\d{2}-[A-Za-z]{3}-\\d{4}$`), toString(toDate(date_of_birth, 'dd-MMM-yyyy'), 'yyyy-MM-dd'), iif(regexMatch(date_of_birth, `^[A-Za-z]+ \\d{1,2}, \\d{4}$`), toString(toDate(date_of_birth, 'MMMM dd, yyyy'), 'yyyy-MM-dd'), iif(regexMatch(date_of_birth, `^\\d{2}-\\d{2}-\\d{2}$`), concat(iif(toInteger(regexExtract(date_of_birth, `^\\d{2}-\\d{2}-(\\d{2})$`, 1)) <= 26, '20', '19'), regexExtract(date_of_birth, `^\\d{2}-\\d{2}-(\\d{2})$`, 1), '-', regexExtract(date_of_birth, `^(\\d{2})-\\d{2}-\\d{2}$`, 1), '-', regexExtract(date_of_birth, `^\\d{2}-(\\d{2})-\\d{2}$`, 1)), toString(null())))))))) ~> derivedColumn3",
				"derivedColumn3 filter(!isNull(patient_id) && isInteger(patient_id) &&",
				"     !isNull(full_name) && length(full_name) <= 250 &&",
				"     (isNull(gender) || length(gender) <= 10) &&",
				"     (isNull(phone) || length(phone) <= 50) &&",
				"     (isNull(email) || length(email) <= 255) &&",
				"     (isNull(address) || length(address) <= 500) &&",
				"     (isNull(insurance_provider) || length(insurance_provider) <= 150)) ~> filterValidos",
				"filterValidos derive(patient_id = toInteger(patient_id),",
				"          date_of_birth = toDate(date_of_birth, 'yyyy-MM-dd')) ~> derivedColumn4",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}