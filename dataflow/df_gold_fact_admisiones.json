{
	"name": "df_gold_fact_admisiones",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "ds_gold_dim_paciente",
						"type": "DatasetReference"
					},
					"name": "sourcePaciente"
				},
				{
					"dataset": {
						"referenceName": "ds_gold_dim_departamento",
						"type": "DatasetReference"
					},
					"name": "sourceDepartamento"
				},
				{
					"dataset": {
						"referenceName": "ds_gold_dim_fecha",
						"type": "DatasetReference"
					},
					"name": "sourceFechaIngreso"
				},
				{
					"dataset": {
						"referenceName": "ds_gold_dim_fecha",
						"type": "DatasetReference"
					},
					"name": "sourceFechaAlta"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_gold_dim_admisiones",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "lookupPaciente"
				},
				{
					"name": "lookupDepartamento",
					"description": "."
				},
				{
					"name": "lookupFechaIngreso",
					"description": "."
				},
				{
					"name": "lookupFechaAlta",
					"description": "."
				},
				{
					"name": "derivedColumn1",
					"description": "."
				},
				{
					"name": "filterValidos",
					"description": "."
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          department as string,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          attending_doctor_id as integer,",
				"          dias_estancia as integer",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT admission_id, patient_id, department, admission_date, discharge_date, attending_doctor_id, DATEDIFF(day, admission_date, discharge_date) AS dias_estancia FROM silver.admissions',",
				"     format: 'query') ~> source1",
				"source(output(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT paciente_key, patient_id_bk FROM gold.dim_paciente',",
				"     format: 'query') ~> sourcePaciente",
				"source(output(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT departamento_key, nombre_departamento FROM gold.dim_departamento',",
				"     format: 'query') ~> sourceDepartamento",
				"source(output(",
				"          fecha_ingreso_key as integer,",
				"          fecha_completa_ingreso as date",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT fecha_key AS fecha_ingreso_key, fecha_completa AS fecha_completa_ingreso FROM gold.dim_fecha',",
				"     format: 'query') ~> sourceFechaIngreso",
				"source(output(",
				"          fecha_alta_key as integer,",
				"          fecha_completa_alta as date",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT fecha_key AS fecha_alta_key, fecha_completa AS fecha_completa_alta FROM gold.dim_fecha',",
				"     format: 'query') ~> sourceFechaAlta",
				"source1, sourcePaciente lookup(patient_id == patient_id_bk,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupPaciente",
				"lookupPaciente, sourceDepartamento lookup(department == nombre_departamento,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupDepartamento",
				"lookupDepartamento, sourceFechaIngreso lookup(admission_date == fecha_completa_ingreso,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupFechaIngreso",
				"lookupFechaIngreso, sourceFechaAlta lookup(discharge_date == fecha_completa_alta,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookupFechaAlta",
				"lookupFechaAlta derive(admission_id_bk = admission_id,",
				"          medico_id = attending_doctor_id,",
				"          conteo_admisiones = 1) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(admission_id_bk) &&",
				"     !isNull(paciente_key) &&",
				"     !isNull(departamento_key) &&",
				"     !isNull(fecha_ingreso_key) &&",
				"     !isNull(medico_id) &&",
				"     (isNull(discharge_date) || !isNull(fecha_alta_key))) ~> filterValidos",
				"filterValidos sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          admision_key as long,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          fecha_ingreso_key as integer,",
				"          fecha_alta_key as integer,",
				"          medico_id as integer,",
				"          dias_estancia as integer,",
				"          conteo_admisiones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id_bk,",
				"          paciente_key,",
				"          departamento_key,",
				"          fecha_ingreso_key,",
				"          fecha_alta_key,",
				"          medico_id,",
				"          dias_estancia,",
				"          conteo_admisiones",
				"     )) ~> sink1"
			]
		}
	}
}